{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigFile": "nixpacks.toml"
  },
  "deploy": {
    "startCommand": "gunicorn -w 1 --threads 8 -b 0.0.0.0:$PORT app:app",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/healthz"
  }
}